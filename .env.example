ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=1024
LOG_DIR=logs

# Classmates' MCP servers (functionality 6) are OFF by default so daily runs
# don't need their venvs/Go binary/MySQL up just to use your own stuff. Set to
# "true" only when you want to demo/test functionality 6:
# ENABLE_CLASSMATE_SERVERS=true

# Path to the DocFinder MCP server repo (only needed if you cloned it somewhere
# other than as a sibling folder of this project):
# DOCFINDER_SERVER_PATH=C:\path\to\docfinder-mcp-server

# Classmates' MCP servers - only needed if you cloned them somewhere other
# than external-mcp-servers/<repo-name> next to this project:
# HOTEL_SERVER_PATH=C:\path\to\hotel-mcp-server
# HOTEL_SERVER_PYTHON=C:\path\to\hotel-mcp-server\.venv\Scripts\python.exe
# RRHH_SERVER_PATH=C:\path\to\mcp-server-rrhh-construccion
# RRHH_SERVER_PYTHON=C:\path\to\mcp-server-rrhh-construccion\.venv\Scripts\python.exe
# BREWOPS_SERVER_BINARY=C:\path\to\brewops-mcp\brewops.exe
# BIBLIOTECA_SERVER_PATH=C:\path\to\tismajo-proyecto1\backend
# BIBLIOTECA_SERVER_PYTHON=C:\path\to\tismajo-proyecto1\backend\.venv\Scripts\python.exe

# hotel-remote (revised functionality 6, over the local network) - URL of a
# tools/mcp-network-bridge instance wrapping any classmate's stdio server.
# For a real two-machine LAN demo, use the bridge machine's LAN IP instead of localhost.
# MCP_REMOTE_URL=http://localhost:4100/mcp

# Web UI backend (chatbot/src/server.ts) - every message costs real API credits,
# so it's loopback-only by default. Only change WEB_SERVER_HOST if you deliberately
# want it reachable from other machines (e.g. presenting from a second device on the
# same network), and if you do, ALSO set WEB_UI_ACCESS_CODE or anyone on that network
# can chat with your API key for free.
# WEB_SERVER_PORT=8787
# WEB_SERVER_HOST=0.0.0.0
# WEB_UI_ACCESS_CODE=choose-a-password

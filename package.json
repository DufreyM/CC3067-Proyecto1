{
  "name": "cc3067-proyecto1",
  "private": true,
  "version": "0.1.0",
  "description": "MCP-based console chatbot for CC3067 Redes - Proyecto 1",
  "workspaces": [
    "chatbot",
    "servers/*",
    "tools/*"
  ],
  "scripts": {
    "chatbot": "npm run start --workspace=chatbot",
    "bridge": "npm run start --workspace=mcp-network-bridge --",
    "web-server": "npm run web-server --workspace=chatbot",
    "web-client": "npm run dev --prefix chatbot/web",
    "build": "npm run build --workspaces --if-present"
  },
  "license": "MIT"
}
